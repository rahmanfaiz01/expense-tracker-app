# Backend environment variables (copy to .env for local development).

# Application
PROJECT_NAME="Expense Tracker API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker

# Database used by the test suite. It is dropped and recreated on every run,
# so it must NOT point at a database with real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/expense_tracker_test

# CORS: comma-separated list of allowed frontend origins
BACKEND_CORS_ORIGINS=http://localhost:5173

# Authentication. Generate a production secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder when ENVIRONMENT=production.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Refresh-token cookie. These defaults work for local http development.
# For Vercel (frontend) -> Railway (backend) the cookie is cross-site, so set:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=none
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Rate limiting for the auth endpoints (slowapi syntax, per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REFRESH=30/minute
